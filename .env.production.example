# Reference-only production input contract. Do not commit real secret values.
SPRING_PROFILES_ACTIVE=production
SPRING_DATASOURCE_URL=jdbc:mysql://<private-db>:3306/<schema>?sslMode=VERIFY_IDENTITY
SPRING_DATASOURCE_USERNAME=<least-privilege-runtime-user>
# Inject SPRING_DATASOURCE_PASSWORD from the runtime secret manager.
APP_MIGRATION_ENABLED=false
# In a separate approved migration step, inject MIGRATION_DB_USERNAME/PASSWORD.
APP_SECURITY_JWT_ISSUER=https://<public-api>
APP_SECURITY_JWT_AUDIENCE=smart-recruitment-api
APP_SECURITY_JWT_KEY_ID=<rotation-key-id>
APP_SECURITY_JWT_PRIVATE_KEY_LOCATION=file:/run/secrets/jwt-private.pem
APP_SECURITY_JWT_PUBLIC_KEY_LOCATION=file:/run/secrets/jwt-public.pem
APP_NOTIFICATION_PROVIDER=<ses-or-smtp-adapter>
APP_WEB_CORS_ALLOWED_ORIGINS=https://<frontend>
APP_TEST_MAILBOX_ENABLED=false
APP_IDENTITY_BOOTSTRAP_ADMIN_ENABLED=false
GEMINI_ENABLED=false
GOOGLE_OAUTH_ENABLED=false
SERVER_FORWARD_HEADERS_STRATEGY=none
APP_SECURITY_CLIENT_IP_TRUST_FORWARDED_HEADER=false
APP_BIND_ADDRESS=127.0.0.1
