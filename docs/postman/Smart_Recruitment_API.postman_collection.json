{
  "info": {
    "_postman_id": "a90df23e-63ef-4475-802c-15a968600123",
    "name": "Smart Recruitment Platform API",
    "description": "Postman Collection để kiểm thử toàn bộ các API hiện có trong dự án Smart Recruitment Platform bao gồm Actuator, Authentication/Identity, và Security Deny-All Verification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Actuator (Health & Info)",
