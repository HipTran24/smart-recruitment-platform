# Copy this file to .env and replace every value before starting Docker Compose.
# .env is intentionally ignored by Git.

MYSQL_DATABASE=smartrecruit_db
MYSQL_USER=smartrecruit_app
MYSQL_PASSWORD=replace-with-a-strong-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-local-password
MYSQL_PORT=3306
APP_PORT=8080
