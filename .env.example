# Copy this file to .env and replace every value before starting Docker Compose.
# .env is intentionally ignored by Git.

MYSQL_DATABASE=smartrecruit_db
MYSQL_USER=smartrecruit_app
MYSQL_PASSWORD=replace-with-a-strong-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-local-password
MYSQL_PORT=3306
APP_PORT=8080
FRONTEND_PORT=8443
SERVER_SESSION_COOKIE_SECURE=false
SERVER_FORWARD_HEADERS_STRATEGY=none

# Comma-separated exact origins only; keep empty when no browser SPA calls the API.
APP_WEB_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Bootstrap initial platform administrator on first boot (disabled by default)
APP_IDENTITY_BOOTSTRAP_ADMIN_ENABLED=false
APP_IDENTITY_BOOTSTRAP_ADMIN_EMAIL=
APP_IDENTITY_BOOTSTRAP_ADMIN_PASSWORD=
APP_IDENTITY_BOOTSTRAP_ADMIN_FULL_NAME=Platform Administrator

# Test mailbox harness (disabled by default, only enable for local/test environments)
APP_TEST_MAILBOX_ENABLED=false

# JWT signing keys are generated locally and must never be committed. Both
# values below must be absolute paths to a PKCS#8 private PEM and matching
# X.509 public PEM. Generate them with ./scripts/generate-local-jwt-keys.sh.
JWT_PRIVATE_KEY_FILE=replace-with-absolute-path-to-private.pem
JWT_PUBLIC_KEY_FILE=replace-with-absolute-path-to-public.pem
APP_SECURITY_JWT_ISSUER=http://localhost:8080
APP_SECURITY_JWT_AUDIENCE=smart-recruitment-api
APP_SECURITY_JWT_KEY_ID=local-dev-key
APP_SECURITY_JWT_ACCESS_TOKEN_TTL=PT15M
APP_SECURITY_JWT_REFRESH_TOKEN_TTL=P30D
APP_SECURITY_JWT_CLOCK_SKEW=PT30S

# Optional integrations are disabled by default. Keep Google and Gemini
# credentials in a local secret store or deployment secret manager.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_SUCCESS_REDIRECT_URI=
GOOGLE_OAUTH_AUTHORIZATION_CODE_TTL=PT1M
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_VERSION=v1beta
GEMINI_CONNECT_TIMEOUT=PT3S
GEMINI_READ_TIMEOUT=PT30S
GEMINI_MAX_RESUME_CHARACTERS=60000
GEMINI_MAX_JOB_DESCRIPTION_CHARACTERS=24000
GEMINI_MAX_REQUIRED_CRITERIA=40
GEMINI_MAX_OUTPUT_TOKENS=1024
# Do not set true outside an isolated local test stub.
GEMINI_ALLOW_INSECURE_ENDPOINT=false
